{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/instituto-Rafael/relativity-living-light/schemas/scientific_infinity_cycle.schema.json",
  "title": "Scientific Infinity Cycle",
  "description": "Structural contract for finite, budgeted scientific executions over mathematical, potential, physical, computational or evolutionary infinity concepts. Passing this contract does not establish physical infinity, cosmological validity, consciousness or external scientific truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "infinity_classes",
    "execution_scope",
    "observations",
    "decision",
    "claim_allowed",
    "claim_boundary",
    "next_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "infinity_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "infinity_math",
          "infinity_potential",
          "infinity_physical",
          "infinity_computational",
          "infinity_evolutionary",
          "TOKEN_VAZIO"
        ]
      }
    },
    "execution_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_iterations",
        "timeout_seconds",
        "convergence_tolerance",
        "novelty_floor",
        "evidence_floor",
        "max_duplication_ratio",
        "max_unresolved_contradictions"
      ],
      "properties": {
        "mode": {"const": "finite_budgeted"},
        "max_iterations": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "convergence_tolerance": {"type": "number", "minimum": 0},
        "novelty_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "max_duplication_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_unresolved_contradictions": {"type": "integer", "minimum": 0}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration",
          "state_digest",
          "novelty",
          "evidence_strength",
          "duplication_ratio",
          "unresolved_contradictions",
          "elapsed_seconds"
        ],
        "properties": {
          "iteration": {"type": "integer", "minimum": 0},
          "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "duplication_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "unresolved_contradictions": {"type": "integer", "minimum": 0},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "objective_value": {"type": ["number", "null"]}
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "continue",
        "converged",
        "cycle_detected",
        "budget_exhausted",
        "TOKEN_VAZIO"
      ]
    },
    "claim_allowed": {
      "const": false
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "blocked_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "next_gate": {
      "type": "string",
      "minLength": 1
    }
  }
}
