{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rll/orcid_vector_artifact.schema.json",
  "title": "RLL ORCID Vector Evolution Artifact",
  "description": "Structural contract for append-only ORCID metadata artifacts, provenance, deterministic vectors, and claim-bounded evolution in RLL. Conformance validates structure only; it does not validate a scientific claim.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "logical_id",
    "revision",
    "owner_orcid",
    "title",
    "disciplines",
    "metadata_state",
    "claim_allowed",
    "provenance",
    "vector"
  ],
  "properties": {
    "schema": {"const": "rll.orcid_vector.v1"},
    "logical_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "parent_artifact_id": {"type": ["integer", "null"], "minimum": 1},
    "owner_orcid": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
        {"const": "TOKEN_VAZIO_ORCID_ID"}
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "abstract": {"type": ["string", "null"]},
    "doi": {"type": ["string", "null"]},
    "publication_year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 9999},
    "disciplines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "mathematics",
          "physics",
          "physics.classical",
          "physics.quantum",
          "chemistry",
          "biology",
          "physiology",
          "unclassified"
        ]
      }
    },
    "metadata_state": {
      "enum": [
        "ORCID_INGESTED",
        "VERIFIED_METADATA",
        "PARTIAL_METADATA",
        "METADATA_CONFLICT",
        "FLAGGED_RETRACTION",
        "TOKEN_VAZIO"
      ]
    },
    "claim_allowed": {"const": false},
    "provenance": {
      "type": "object",
      "required": ["sources", "content_sha256", "event_chain_tip"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["provider", "source_record_id", "payload_sha256"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "source_record_id": {"type": "string", "minLength": 1},
              "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_chain_tip": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "vector": {
      "type": "object",
      "required": ["model", "dimensions", "values", "text_sha256"],
      "properties": {
        "model": {"const": "rll-hash32-v1"},
        "dimensions": {"const": 32},
        "values": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}
        },
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "next_gate": {"type": "string", "minLength": 1}
  }
}
