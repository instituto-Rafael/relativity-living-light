{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rll/rll_route_forest.schema.json",
  "title": "RLL Omega Route Forest",
  "description": "Structural contract for a compiled RLL Omega knowledge-route forest with auditable flow counts, seven-direction operational vectors, acyclic trees and machine-learning readiness gates. It does not train a model, establish physical geometry or validate scientific claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "forest_id",
    "generated_at",
    "source_commit",
    "source_refs",
    "claim_allowed",
    "boundaries",
    "frequency_window",
    "vector_basis",
    "regions",
    "nodes",
    "routes",
    "trees",
    "metrics",
    "state",
    "next_gate"
  ],
  "properties": {
    "schema": {"const": "rll.route_forest.v1"},
    "forest_id": {"type": "string", "pattern": "^RLL-[A-Z0-9-]{8,80}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/path"}
    },
    "claim_allowed": {"const": false},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "vectors", "machine_learning"],
      "properties": {
        "frequency": {"type": "string", "minLength": 20},
        "vectors": {"type": "string", "minLength": 20},
        "machine_learning": {"type": "string", "minLength": 20}
      }
    },
    "frequency_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "window_kind", "unit", "event_count", "event_records"],
      "properties": {
        "window_id": {"type": "string", "minLength": 3},
        "window_kind": {"const": "structural_snapshot"},
        "unit": {"const": "events_per_snapshot"},
        "event_count": {"type": "integer", "minimum": 0},
        "event_records": {"type": "integer", "minimum": 0}
      }
    },
    "vector_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "directions", "score_scale", "normalization", "boundary"],
      "properties": {
        "class": {"const": "[C]"},
        "directions": {
          "type": "array",
          "prefixItems": [
            {"const": "D1"},
            {"const": "D2"},
            {"const": "D3"},
            {"const": "D4"},
            {"const": "D5"},
            {"const": "D6"},
            {"const": "D7"}
          ],
          "items": false
        },
        "score_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3", "4"],
          "properties": {
            "0": {"type": "string"},
            "1": {"type": "string"},
            "2": {"type": "string"},
            "3": {"type": "string"},
            "4": {"type": "string"}
          }
        },
        "normalization": {"type": "string", "minLength": 5},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "regions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/region"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    },
    "trees": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tree"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_count",
        "tree_count",
        "node_count",
        "route_count",
        "event_count",
        "weighted_flow",
        "orphan_count",
        "cycle_count",
        "max_depth",
        "mean_vector_norm"
      ],
      "properties": {
        "region_count": {"const": 7},
        "tree_count": {"type": "integer", "minimum": 1},
        "node_count": {"type": "integer", "minimum": 1},
        "route_count": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 1},
        "weighted_flow": {"type": "integer", "minimum": 1},
        "orphan_count": {"const": 0},
        "cycle_count": {"const": 0},
        "max_depth": {"type": "integer", "minimum": 1},
        "mean_vector_norm": {"type": "number", "minimum": 0}
      }
    },
    "state": {
      "enum": ["STRUCTURAL_MAP_READY_ML_BLOCKED", "STRUCTURAL_MAP_READY"]
    },
    "next_gate": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+%=-]+(?:/[A-Za-z0-9._@+%=-]+)*$"
    },
    "vector": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "delta": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"type": "number", "minimum": -1, "maximum": 1}
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "direction_id",
        "name",
        "description",
        "node_ids",
        "route_ids",
        "centroid_vector",
        "inbound_flow",
        "outbound_flow",
        "total_flow"
      ],
      "properties": {
        "region_id": {"type": "string", "pattern": "^R[1-7]$"},
        "direction_id": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"]},
        "name": {"type": "string", "minLength": 3},
        "description": {"type": "string", "minLength": 10},
        "node_ids": {"type": "array", "items": {"type": "string"}},
        "route_ids": {"type": "array", "items": {"type": "string"}},
        "centroid_vector": {"$ref": "#/$defs/vector"},
        "inbound_flow": {"type": "integer", "minimum": 0},
        "outbound_flow": {"type": "integer", "minimum": 0},
        "total_flow": {"type": "integer", "minimum": 0}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "tree_id",
        "region_id",
        "label",
        "kind",
        "epistemic_status",
        "parent_id",
        "vector",
        "vector_norm",
        "source_refs"
      ],
      "properties": {
        "node_id": {"type": "string"},
        "tree_id": {"type": "string"},
        "region_id": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"type": "string"},
        "epistemic_status": {"type": "string"},
        "parent_id": {"anyOf": [{"type": "null"}, {"type": "string"}]},
        "vector": {"$ref": "#/$defs/vector"},
        "vector_norm": {"type": "number", "minimum": 0},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "tree_id",
        "source_node_id",
        "target_node_id",
        "relation_type",
        "source_refs",
        "claim_allowed",
        "flow_frequency",
        "frequency_unit",
        "event_kinds",
        "vector_delta",
        "delta_norm"
      ],
      "properties": {
        "route_id": {"type": "string"},
        "tree_id": {"type": "string"},
        "source_node_id": {"type": "string"},
        "target_node_id": {"type": "string"},
        "relation_type": {"type": "string"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"}
        },
        "claim_allowed": {"const": false},
        "flow_frequency": {"type": "integer", "minimum": 1},
        "frequency_unit": {"const": "events_per_snapshot"},
        "event_kinds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "vector_delta": {"$ref": "#/$defs/delta"},
        "delta_norm": {"type": "number", "minimum": 0}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_id",
        "domain",
        "root_node_id",
        "purpose",
        "node_ids",
        "route_ids",
        "node_count",
        "route_count",
        "depth",
        "ml_readiness"
      ],
      "properties": {
        "tree_id": {"type": "string"},
        "domain": {"type": "string"},
        "root_node_id": {"type": "string"},
        "purpose": {"type": "string"},
        "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "route_ids": {"type": "array", "items": {"type": "string"}},
        "node_count": {"type": "integer", "minimum": 1},
        "route_count": {"type": "integer", "minimum": 0},
        "depth": {"type": "integer", "minimum": 1},
        "ml_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "state",
            "passed_gates",
            "total_gates",
            "missing_gates",
            "training_allowed"
          ],
          "properties": {
            "role": {
              "enum": ["governance_only", "candidate_dataset", "feature_source", "training_candidate", "evidence_base"]
            },
            "state": {
              "enum": [
                "NOT_APPLICABLE",
                "NOT_READY",
                "FEATURE_ENGINEERING_ONLY",
                "BASELINE_READY",
                "HUMAN_AUTHORIZATION_REQUIRED",
                "TRAINING_ELIGIBLE"
              ]
            },
            "passed_gates": {"type": "integer", "minimum": 0},
            "total_gates": {"const": 12},
            "missing_gates": {"type": "array", "items": {"type": "string"}},
            "training_allowed": {"type": "boolean"}
          }
        }
      }
    }
  }
}
