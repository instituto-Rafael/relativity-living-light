{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/instituto-Rafael/relativity-living-light/blob/main/schemas/rll_observational_topology.v1.schema.json",
  "title": "RLL observational topology — append-only fail-closed contract",
  "description": "Structural contract for an auditable RLL integration topology. It describes evidence readiness and gates; it never certifies a cosmological claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generated_at",
    "repository",
    "source_main_commit",
    "append_only",
    "claim_allowed",
    "publication_ready",
    "authority_order",
    "state_machine",
    "invariants",
    "nodes",
    "topological_edges",
    "promotion_gate"
  ],
  "properties": {
    "schema": {
      "const": "rll.observational_topology.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^20260808\\.v1$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "instituto-Rafael/relativity-living-light"
    },
    "source_main_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "append_only": {
      "const": true
    },
    "claim_allowed": {
      "const": false
    },
    "publication_ready": {
      "const": false
    },
    "authority_order": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_closed_default",
        "states"
      ],
      "properties": {
        "fail_closed_default": {
          "const": "TOKEN_VAZIO"
        },
        "states": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "MATERIALIZED",
              "VERIFIED_LIMITED",
              "OPEN_INTERNAL",
              "OPEN_EXTERNAL",
              "BLOCKED_DEPENDENCY",
              "INVALIDATED",
              "TOKEN_VAZIO"
            ]
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 17,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "topological_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_claim_allowed",
        "required_conditions",
        "safe_current_conclusion"
      ],
      "properties": {
        "scientific_claim_allowed": {
          "const": false
        },
        "required_conditions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe_current_conclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "note"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "token_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tokens",
        "queue_effect"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "BOUND_CURRENT_TOKEN",
            "HISTORICAL_CHAIN_TERMINAL",
            "UNBOUND_TOKEN_VAZIO",
            "MULTI_SOURCE_GAP"
          ]
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TOKEN_VAZIO_"
          }
        },
        "queue_effect": {
          "type": "string",
          "enum": [
            "existing_queue",
            "topology_only",
            "historical_only",
            "mixed"
          ]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflicting_paths",
        "resolution_gate",
        "safe_interpretation"
      ],
      "properties": {
        "conflicting_paths": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution_gate": {
          "type": "string",
          "minLength": 1
        },
        "safe_interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "domain",
        "observable",
        "state",
        "priority",
        "observation_class",
        "ready_for_joint_inference",
        "source_status",
        "current_evidence",
        "token_binding",
        "required_gates",
        "dependencies",
        "claim_boundary",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(OBS|MECH)-[A-Z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "mechanism"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "background",
            "structure",
            "cmb",
            "lensing",
            "propagation",
            "comparison",
            "theory"
          ]
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "MATERIALIZED",
            "VERIFIED_LIMITED",
            "OPEN_INTERNAL",
            "OPEN_EXTERNAL",
            "BLOCKED_DEPENDENCY",
            "INVALIDATED",
            "TOKEN_VAZIO"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "observation_class": {
          "type": "string",
          "enum": [
            "cosmology",
            "propagation",
            "comparison",
            "theory"
          ]
        },
        "ready_for_joint_inference": {
          "const": false
        },
        "source_status": {
          "type": "string",
          "minLength": 1
        },
        "current_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "token_binding": {
          "$ref": "#/$defs/token_binding"
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(OBS|MECH)-[A-Z0-9-]+$"
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "contradiction": {
          "$ref": "#/$defs/contradiction"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation",
        "why"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(OBS|MECH)-[A-Z0-9-]+$"
        },
        "to": {
          "type": "string",
          "pattern": "^(OBS|MECH)-[A-Z0-9-]+$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "requires",
            "shares_likelihood_contract",
            "must_precede"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
