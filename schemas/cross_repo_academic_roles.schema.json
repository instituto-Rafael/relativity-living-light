{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rll.local/schemas/cross-repo-academic-roles-v1.json",
  "title": "RLL Cross Repository Academic Roles V1",
  "description": "Structural contract for cross-repository academic roles, custody boundaries and fail-closed scientific promotion gates; schema validity does not authorize a scientific claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "claim_allowed", "scientific_authority", "reference_doi", "canonical_orcid", "repositories", "promotion_gate", "ledger_boundary"],
  "properties": {
    "schema": {"const": "rll.cross-repo-academic-roles.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "claim_allowed": {"const": false},
    "scientific_authority": {"const": "instituto-Rafael/relativity-living-light"},
    "reference_doi": {"type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$"},
    "canonical_orcid": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "base_commit", "proposed_head", "pull_request", "role", "allowed_outputs", "prohibited_claims"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "proposed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "pull_request": {"type": "string", "format": "uri"},
          "role": {"type": "string", "minLength": 1},
          "allowed_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "prohibited_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "promotion_gate": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "ledger_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_chain", "blockchain_consensus", "digital_signature", "triple_digest_profiles"],
      "properties": {
        "hash_chain": {"const": true},
        "blockchain_consensus": {"const": false},
        "digital_signature": {"type": "string"},
        "triple_digest_profiles": {"type": "array", "minItems": 3, "items": {"type": "string"}}
      }
    }
  }
}
