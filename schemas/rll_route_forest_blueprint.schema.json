{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rll/rll_route_forest_blueprint.schema.json",
  "title": "RLL Omega Route Forest Blueprint",
  "description": "Structural contract for a declarative RLL Omega route-forest blueprint, including real-data and methodology topology without authorizing scientific claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "forest_id",
    "generated_at",
    "source_commit",
    "claim_allowed",
    "frequency_semantics",
    "vector_semantics",
    "regions",
    "nodes",
    "routes",
    "trees",
    "source_refs",
    "next_gate"
  ],
  "properties": {
    "schema": {"const": "rll.route_forest_blueprint.v1"},
    "forest_id": {"type": "string", "pattern": "^RLL-[A-Z0-9-]{8,80}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "claim_allowed": {"const": false},
    "frequency_semantics": {
      "type": "object",
      "required": ["class", "window_id", "window_kind", "unit", "definition", "boundary"],
      "additionalProperties": false,
      "properties": {
        "class": {"const": "[C]"},
        "window_id": {"type": "string"},
        "window_kind": {"const": "structural_snapshot"},
        "unit": {"const": "events_per_snapshot"},
        "definition": {"type": "string", "minLength": 20},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "vector_semantics": {
      "type": "object",
      "required": ["class", "directions", "score_scale", "normalization", "boundary"],
      "additionalProperties": false,
      "properties": {
        "class": {"const": "[C]"},
        "directions": {
          "type": "array",
          "prefixItems": [
            {"const": "D1"}, {"const": "D2"}, {"const": "D3"},
            {"const": "D4"}, {"const": "D5"}, {"const": "D6"}, {"const": "D7"}
          ],
          "items": false
        },
        "score_scale": {
          "type": "array",
          "prefixItems": [
            {"const": "absent"}, {"const": "gap"}, {"const": "partial"},
            {"const": "ready_for_test"}, {"const": "verified"}
          ],
          "items": false
        },
        "normalization": {"type": "string"},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "regions": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": {"$ref": "#/$defs/region"}
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/node"}
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/route"}
    },
    "trees": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/tree"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/path"}
    },
    "next_gate": {"type": "string", "minLength": 20}
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+%=-]+(?:/[A-Za-z0-9._@+%=-]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^N-[A-Za-z0-9-]+$"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "name", "description"],
      "properties": {
        "direction": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"]},
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 10}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "region", "label", "kind", "status", "scores", "refs", "parent"],
      "properties": {
        "tree": {"type": "string", "pattern": "^T-[A-Z0-9-]+$"},
        "region": {"type": "string", "pattern": "^R[1-7]$"},
        "label": {"type": "string"},
        "kind": {"enum": ["root", "artifact", "gap", "control", "hypothesis", "dataset"]},
        "status": {"enum": ["VERIFIED", "READY_FOR_TEST", "PARTIAL", "BLOCKED", "TOKEN_VAZIO", "HYPOTHESIS"]},
        "scores": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
        "parent": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/node_id"}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "n_obs": {"type": "integer", "minimum": 0},
        "z_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "arxiv": {"type": "string", "minLength": 4},
        "token_vazio": {"type": "string", "minLength": 5},
        "partial_resolution_note": {"type": "string", "minLength": 5}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "source", "target", "relation", "refs"],
      "properties": {
        "tree": {"type": "string", "pattern": "^T-[A-Z0-9-]+$"},
        "source": {"$ref": "#/$defs/node_id"},
        "target": {"$ref": "#/$defs/node_id"},
        "relation": {
          "enum": [
            "governs", "evaluates", "derives", "opens_gap", "expands",
            "projects", "constrains", "routes", "blocked_by", "defines",
            "anchors", "partial_anchor"
          ]
        },
        "status": {"enum": ["verified", "partial_resolution", "TOKEN_VAZIO"]},
        "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "root", "purpose", "nodes", "ml_role", "ml_gates", "training_allowed"],
      "properties": {
        "domain": {"type": "string"},
        "root": {"$ref": "#/$defs/node_id"},
        "purpose": {"type": "string", "minLength": 10},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/node_id"}
        },
        "ml_role": {"enum": ["governance_only", "candidate_dataset", "feature_source", "training_candidate", "evidence_base"]},
        "ml_gates": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"type": "boolean"}
        },
        "training_allowed": {"type": "boolean"},
        "canonical_manifest": {"$ref": "#/$defs/path"},
        "canonical_document": {"$ref": "#/$defs/path"}
      }
    }
  }
}
