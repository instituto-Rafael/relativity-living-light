{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/instituto-Rafael/relativity-living-light/schemas/rll_canonical_family_pipeline_receipt_v1.schema.json",
  "title": "RLL Canonical Family Pipeline Final Receipt V1",
  "description": "Structural contract for the canonical cross-family pipeline final receipt, custody hashes, fail-closed scientific gates and R3 closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pipeline_state",
    "claim_allowed",
    "source_boundary",
    "head_sha",
    "run_id",
    "child_receipts",
    "gates",
    "physical_boundaries",
    "r3"
  ],
  "properties": {
    "schema": {"const": "rll.canonical_family_pipeline.final_receipt.v1"},
    "pipeline_state": {"enum": ["PASS_FAIL_CLOSED", "FAIL"]},
    "claim_allowed": {"const": false},
    "source_boundary": {"const": "SOURCE != ARTIFACT != EXECUTION != EVIDENCE != CLAIM"},
    "head_sha": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "child_receipts": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "domain", "state", "evidence", "boundary"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^G[0-9]{2}-[A-Z0-9-]+$"},
          "domain": {"type": "string", "minLength": 1},
          "state": {"enum": ["PASS", "FAIL"]},
          "evidence": {},
          "boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "physical_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fluid_binding", "cosmology_binding", "promotion_rule"],
      "properties": {
        "fluid_binding": {"const": "TOKEN_VAZIO_FLUID_BINDING"},
        "cosmology_binding": {"const": "TOKEN_VAZIO_COSMOLOGY_BINDING"},
        "promotion_rule": {"type": "string", "minLength": 1}
      }
    },
    "r3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["F_ok", "F_gap", "F_next"],
      "properties": {
        "F_ok": {"type": "string", "minLength": 1},
        "F_gap": {"type": "string", "minLength": 1},
        "F_next": {"type": "string", "minLength": 1}
      }
    }
  }
}
