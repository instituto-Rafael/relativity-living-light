{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/instituto-Rafael/relativity-living-light/schemas/discrete_ontology_claim.schema.json",
  "title": "RLL discrete ontology and factor-11 claim gate",
  "description": "Structural contract for typed discrete ontology, factor-11 provenance, and claim-gated physical promotion in RLL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "state",
    "claim_allowed",
    "foundation",
    "exact_claims",
    "physical_bridge",
    "exit_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "const": "EV-ONTOLOGY-FACTOR11-001"
    },
    "state": {
      "const": "TOKEN_VAZIO"
    },
    "claim_allowed": {
      "const": false
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typed_empty_class",
        "cardinality_zero",
        "unit_class",
        "word_11"
      ],
      "properties": {
        "typed_empty_class": {
          "type": "string",
          "minLength": 1
        },
        "cardinality_zero": {
          "type": "string",
          "minLength": 1
        },
        "unit_class": {
          "type": "string",
          "minLength": 1
        },
        "word_11": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exact_claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "statement",
          "test"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F11-E-[0-9]{2}$"
          },
          "state": {
            "const": "PASS_EXACT"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "physical_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "question",
        "known",
        "unknowns",
        "prohibited_claims",
        "next_gate"
      ],
      "properties": {
        "state": {
          "const": "TOKEN_VAZIO"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "known": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exit_conditions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_required",
          "acceptance_criterion"
        ],
        "properties": {
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
