{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rll.science_ingress_manifest.v1",
  "title": "RLL Science Ingress Manifest V1",
  "type": "object",
  "required": ["schema", "version", "claim_allowed", "sources"],
  "properties": {
    "schema": {"const": "rll.science_ingress_manifest.v1"},
    "version": {"type": "string"},
    "claim_allowed": {"const": false},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "url",
          "filename",
          "authority",
          "license",
          "expected_sha256",
          "max_bytes",
          "credential_profile"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["image", "pdf", "data", "text", "webpage", "archive"]
          },
          "url": {"type": "string", "pattern": "^https://"},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "authority": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "expected_sha256": {
            "oneOf": [
              {"const": "TOKEN_VAZIO"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "credential_profile": {
            "enum": [
              "none",
              "pat_actions",
              "pat_agents",
              "pat_env",
              "pat_environments"
            ]
          },
          "role": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
