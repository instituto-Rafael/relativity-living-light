{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instituto-rafael.example/schemas/rll-evidence-experiment-v1.json",
  "title": "RLL Evidence Experiment V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "title", "repository_root", "claim_allowed", "publication_effect", "inputs", "steps", "receipt"],
  "properties": {
    "schema": {"const": "rll_evidence_experiment_v1"},
    "experiment_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 3},
    "repository_root": {"type": "string", "minLength": 1},
    "claim_allowed": {"const": false},
    "publication_effect": {"const": "NONE"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "expected_bytes": {"type": "integer", "minimum": 0},
          "expected_sha256": {"type": "string", "pattern": "^(TOKEN_VAZIO|[0-9a-fA-F]{64})$"},
          "sha256_sidecar": {"type": "string", "minLength": 1}
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "expected_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "media_type": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "result_extractors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "rows_path": {"type": "array", "items": {"type": "string"}},
          "model_key": {"type": "string"},
          "include_models": {"type": "array", "items": {"type": "string"}},
          "metrics": {"type": "array", "items": {"enum": ["chi2", "AIC", "AICc", "BIC", "N", "k", "dof"]}}
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseline", "candidate"],
        "properties": {
          "baseline": {"type": "string"},
          "candidate": {"type": "string"},
          "metrics": {"type": "array", "items": {"enum": ["chi2", "AIC", "AICc", "BIC"]}}
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "F_ok": {"type": "array", "items": {"type": "string"}},
    "F_gap": {"type": "array", "items": {"type": "string"}},
    "F_next": {"type": "array", "items": {"type": "string"}}
  }
}
