{
  "schema": "rll.data_use_purpose_registry.v1",
  "version": "1.0.0",
  "status": "ACTIVE_GOVERNED_DRAFT",
  "claim_allowed": false,
  "compliance_claim": false,
  "principle": "Collect/use only what is necessary for a declared purpose; unknown or sensitive classes fail closed to human review.",
  "actors": {
    "human_operator": {
      "description": "Person explicitly invoking a local command or approving/reviewing repository changes.",
      "may_set_goal": true,
      "may_expand_scope": "ONLY_BY_EXPLICIT_NEW_OPERATION_OR_REVIEW"
    },
    "reviewed_ci_workflow": {
      "description": "Repository-reviewed deterministic workflow executing a declared operation.",
      "may_set_goal": false,
      "may_expand_scope": false
    },
    "deterministic_program": {
      "description": "Program executes only the operation contract supplied to it.",
      "may_set_goal": false,
      "may_expand_scope": false,
      "self_authorize": false
    },
    "autonomous_agent": {
      "allowed": false,
      "reason": "Development envelope forbids autonomous goal setting/scope expansion for governed RLL runtime."
    }
  },
  "routes": [
