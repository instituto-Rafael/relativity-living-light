        "writes": false
      },
      "filesystem": {
        "read": "repository declared inputs",
        "write": [
          "validacao_real/fetched_rx/",
          "validacao_real/results_rx/"
        ]
      },
      "retention": {
        "local": "operator controlled",
        "ci_artifact_days": 30,
        "repository_commit": "explicit opt-in only"
