{
  "schema": "rll.agent_secret_roles.v1",
  "status": "DECLARED_BY_OWNER_RUNTIME_NOT_YET_PROBED",
  "claim_allowed": false,
  "publication_effect": "NONE",
  "surface": "COPILOT_CLOUD_AGENT_SECRETS",
  "roles": {
    "PATGITHUB": {
      "role": "github_control_plane_pat",
      "use": [
        "github_read",
        "work_branch_push_when_guard_allows",
        "pull_request_create_edit_comment_read",
        "workflow_dispatch_when_contract_allows",
        "failed_run_rerun"
      ],
      "destructive_use": "FORBIDDEN",
      "direct_protected_branch_push": "FORBIDDEN",
      "auto_merge": "FORBIDDEN",
      "runtime_state": "TOKEN_VAZIO_UNTIL_AGENT_PROBE"
    },
    "GIT": {
      "role": "git_transport_candidate",
      "use": "TOKEN_VAZIO_UNTIL_RUNTIME_ROLE_IS_PROBED",
      "must_not_replace_PATGITHUB_implicitly": true,
      "runtime_state": "TOKEN_VAZIO_UNTIL_AGENT_PROBE"
    },
    "CLIMATE": {
      "role": "climate_provider_credential",
      "github_auth": "FORBIDDEN",
      "provider": "Climate Engine",
      "result_state": "EXTERNAL_COMPUTE_PRODUCT",
      "runtime_state": "TOKEN_VAZIO_UNTIL_AGENT_PROBE"
    }
  },
  "invariants": [
    "AGENT_SECRET != ACTIONS_SECRET",
    "SECRET != AUTHORITY != EXECUTION != EVIDENCE != CLAIM",
    "SOURCE != EXECUTION != EVIDENCE != CLAIM",
    "TOKEN_VAZIO != 0"
  ],
  "secret_values": "NOT_READ_NOT_STORED_NOT_HASHED"
}
