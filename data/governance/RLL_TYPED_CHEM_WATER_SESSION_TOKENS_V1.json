  "invariant_of_invariants": [
    {
      "id": "I01",
      "name": "RAW_IDENTITY",
      "rule": "Preserve raw surface string, exact case, Unicode superscripts and charge signs; H!=h; H3!=³H."
    },
    {
      "id": "I02",
      "name": "TYPE_AND_DOMAIN",
      "rule": "One resolved identifier requires explicit kind or canonical id when aliases collide."
    },
    {
      "id": "I03",
      "name": "COMPOSITION_AND_CHARGE",
      "rule": "Stoichiometry and integer charge are independent; C3 (3 carbons) != C3+ (1 carbon 3+)."
    },
    {
      "id": "I04",
      "name": "ISOTOPE_INDEPENDENCE",
      "rule": "Isotope mass number is not molecule atom count; He3 ambiguous without type."
    },
    {
      "id": "I05",
      "name": "PHASE_AND_CONDITIONS",
      "rule": "Specify phase, pressure, temperature, lifetime when claiming stability or water anomalies."
    },
    {
      "id": "I06",
      "name": "DIMENSIONAL_VALIDITY",
      "rule": "Do not identify units of energy, spin, frequency, density, redshift, log-likelihood."
    },
    {
      "id": "I07",
      "name": "CAUSAL_BRIDGE",
      "rule": "No BAO/ΛCDM/neutrino effect is inferred from a name, charge count or water anomaly."
    },
    {
      "id": "I08",
      "name": "SCIENTIFIC_STATUS",
      "rule": "SOURCE != ARTEFACT != EXECUTION != EVIDENCE != CLAIM; prohibit unsupported promotion."
    },
    {
      "id": "I09",
      "name": "AI_HEAD_BOUNDARY",
      "rule": "Only response text and public source are available; no claims about actual model layer/head tensors or hidden weights."
    },
    {
      "id": "I10",
      "name": "REVERSIBLE_VERSIONING",
      "rule": "Literal source survives normalization; derived id and context are separately auditable."
    },
    {
      "id": "I11",
      "name": "ABSENCE_AND_UNCERTAINTY",
      "rule": "Unresolved collisions produce TOKEN_VAZIO_AMBIGUOUS, not zero or guessed chemical species."
    },
    {
      "id": "I12",
      "name": "NULL_VS_ZERO",
      "rule": "Unknown (null) != 0; no atom count, charge, or mass may be filled from absence."
    },
    {
      "id": "I13",
      "name": "SYMMETRY_NOT_IDENTITY",
      "rule": "A shared geometry, spin index, graph pattern or transformer head analogy is not a physical coupling."
    },
    {
      "id": "I14",
      "name": "SOURCE_PROVENANCE",
      "rule": "Scientific assertions link to source and method; raw data hashes and runs are empty until verified."
    }
  ],
