{
  "operation": "persist_public_literature_delta",
  "source": "Crossref public works API (anonymous)",
  "repository": "instituto-Rafael/relativity-living-light",
  "secret_binding": "PAT_ACTIONS",
  "credential_fallback": false,
  "target_branch": "rll/literature-ledger",
  "target_path": "data/chronology/literature.json",
  "events": [
    "schedule",
    "workflow_dispatch"
  ],
  "trusted_ref": "default_branch",
  "precondition": "record delta and matching predecessor blob SHA",
  "verification": "byte equality at returned commit",
  "authority": "owner instruction for literature writer only",
  "runtime_binding": "unverified",
  "claim_allowed": false
}
