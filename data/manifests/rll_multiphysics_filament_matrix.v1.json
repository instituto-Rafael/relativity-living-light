{
  "schema_version": "1.0",
  "matrix_id": "rll-multiphysics-filament-canonical-v1",
  "claim_allowed": false,
  "stdlib_only_validation": true,
  "new_workflow_required": false,
  "purpose": "Scan coupled environmental, electrical, thermal, chemical, acoustic and physiological filaments without collapsing distinct mechanisms.",
  "coupling_policy": {
    "parallel_filaments": true,
    "typed_cross_filament_edges": true,
    "shared_state_without_semantic_collapse": true,
    "coupling_does_not_imply_causality": true,
    "external_evidence_is_not_local_measurement": true,
    "subjective_state_is_not_instrument_measurement": true,
    "numeric_frequency_match_is_not_mechanism_identity": true
  },
  "filaments": [
    {
      "order": 1,
      "id": "electrical_source_coil_ac",
      "domain": "ELECTROMAGNETIC_SOURCE",
      "inputs": ["voltage_rms_V", "current_rms_A", "frequency_Hz", "coil_current_A", "geometry"],
      "outputs": ["electric_field_V_per_m", "magnetic_flux_density_T", "power_W"],
      "mechanism": "MAXWELL_AND_JOULE",
      "evidence_state": "MEASURABLE",
      "local_measurement_state": "TOKEN_VAZIO_LOCAL",
      "blocked_inferences": [
        "APPLIANCE_HAS_COIL_THEREFORE_BRAIN_EFFECT",
        "NUMERIC_FREQUENCY_MATCH_THEREFORE_SAME_MECHANISM"
      ]
    },
    {
      "order": 2,
      "id": "water_spray_charge_ions",
      "domain": "SPRAY_ELECTRIFICATION",
      "inputs": ["droplet_size_distribution_m", "spray_velocity_m_per_s", "water_conductivity_S_per_m", "water_pH", "air_state"],
      "outputs": ["droplet_charge_C", "ion_number_density_per_m3", "local_electric_field_V_per_m"],
      "mechanism": "LENARD_EFFECT_AND_INTERFACIAL_CHARGE_SEPARATION",
      "evidence_state": "EVIDENCED_EXTERNALLY",
      "local_measurement_state": "TOKEN_VAZIO_LOCAL",
      "blocked_inferences": [
        "HEATER_RESISTANCE_DIRECTLY_CAUSES_IONIZATION",
        "AIR_IONS_DIRECTLY_BECOME_NEURAL_ION_CURRENTS"
      ]
    },
    {
      "order": 3,
      "id": "thermal_mass_phase_transfer",
      "domain": "THERMODYNAMICS",
      "inputs": ["water_temperature_C", "air_temperature_C", "skin_temperature_C", "relative_humidity_percent", "air_pressure_Pa", "body_mass_kg"],
      "outputs": ["heat_flux_W_per_m2", "evaporation_rate_kg_per_m2_s", "vapor_pressure_Pa", "thermal_comfort_state"],
      "mechanism": "HEAT_AND_MASS_TRANSFER",
      "evidence_state": "MEASURABLE",
      "local_measurement_state": "TOKEN_VAZIO_LOCAL",
      "blocked_inferences": [
        "WARMTH_ALWAYS_MEANS_RELAXATION",
        "VAPORIZATION_IS_IONIZATION"
      ]
