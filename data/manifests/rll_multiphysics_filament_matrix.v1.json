      "local_measurement_state": "TOKEN_VAZIO_LOCAL",
      "blocked_inferences": [
        "SWEAT_PROTECTS_FROM_ELECTRIC_SHOCK",
        "SKIN_CONDUCTANCE_IS_DIRECT_MEASURE_OF_EMOTION_CONTENT"
      ]
    },
    {
      "order": 5,
      "id": "neuroionic_autonomic_state",
      "domain": "NEUROPHYSIOLOGY",
