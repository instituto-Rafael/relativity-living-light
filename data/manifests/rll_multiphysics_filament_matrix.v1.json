  ],
  "cross_filament_edges": [
    {"from": "electrical_source_coil_ac", "to": "water_spray_charge_ions", "type": "CANDIDATE_COUPLING", "state": "TOKEN_VAZIO_LOCAL"},
    {"from": "thermal_mass_phase_transfer", "to": "skin_sweat_contact_electricity", "type": "MECHANISTIC", "state": "EVIDENCED_EXTERNALLY"},
    {"from": "skin_sweat_contact_electricity", "to": "electrical_fault_lightning_safety", "type": "SAFETY_RELEVANT", "state": "EVIDENCED_EXTERNALLY"},
    {"from": "voice_acoustics_joy_relaxation", "to": "respiration_co2_acid_base", "type": "POSSIBLE_MEDIATED", "state": "TOKEN_VAZIO_LOCAL"},
    {"from": "respiration_co2_acid_base", "to": "cardiac_electric_magnetic_pressure", "type": "PHYSIOLOGICAL_MEDIATED", "state": "EVIDENCED_EXTERNALLY"},
    {"from": "hair_static_point_geometry", "to": "electrical_fault_lightning_safety", "type": "WARNING_CONTEXT", "state": "OFFICIAL_SAFETY_GUIDANCE"},
    {"from": "water_spray_charge_ions", "to": "voice_acoustics_joy_relaxation", "type": "CORRELATION_CANDIDATE_ONLY", "state": "TOKEN_VAZIO_CAUSAL"}
  ],
  "conservation_and_units": {
    "frequency_requires_unit": "Hz",
    "magnetic_flux_density_requires_unit": "T",
    "electric_field_requires_unit": "V/m",
    "charge_requires_unit": "C",
    "conductivity_requires_unit": "S/m",
    "temperature_requires_unit": "degC_or_K_with_conversion",
    "pressure_requires_unit": "Pa",
    "mass_requires_unit": "kg",
    "pH_is_dimensionless_but_requires_sample_and_method": true,
    "energy_mass_charge_accounting_required": true
