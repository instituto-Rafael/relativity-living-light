      "outputs": ["cardiac_electric_state", "magnetocardiographic_field_T", "hemodynamic_state"],
      "mechanism": "CARDIAC_IONIC_CURRENTS_AND_BIOMAGNETIC_FIELD",
      "evidence_state": "EVIDENCED_EXTERNALLY",
      "local_measurement_state": "TOKEN_VAZIO_LOCAL",
      "blocked_inferences": [
