{
  "schema": "rll.cosmology_model_family_shadow.v1",
  "status": "EXPERIMENTAL_SHADOW",
  "claim_allowed": false,
  "canonical_outputs_modified": false,
  "objective": "Compare structurally distinct cosmological backgrounds without adapting observations, errors, covariances, bounds, or parameter counts to favor any model.",
  "scientific_boundary": {
    "included_terms": [
      "H(z)",
      "DESI_DR2_BAO"
    ],
    "excluded_terms": {
      "CMB_shift": "TOKEN_VAZIO_RS_STAR_BACKEND: l_A requires an explicit sound horizon at photon decoupling rather than reusing r_d.",
      "fsigma8": "TOKEN_VAZIO_MODEL_SPECIFIC_GROWTH: the gamma=0.55 proxy is not a fair perturbation backend for every model.",
      "PantheonPlus": "TOKEN_VAZIO_MATERIALIZATION_OR_LIKELIHOOD"
    },
    "comparison_scope": "background_expansion_only",
    "publication_effect": "NONE"
  },
  "closure_policy": {
    "flat_models": "Omega_de0 = 1 - Omega_m0 - Omega_r0 - sum(extra_sector_fractions)",
    "curved_models": "Omega_de0 = 1 - Omega_m0 - Omega_r0 - Omega_k0",
    "free_Omega_Lambda_for_flat_models": false,
    "distance_geometry_must_match_Omega_k": true
  },
  "execution_policy": {
    "optimizer": "scipy.optimize.differential_evolution",
    "same_objective_for_all_models": true,
    "same_data_for_all_models": true,
    "same_covariance_for_all_models": true,
    "bounds_frozen_before_execution": true,
    "post_hoc_bound_changes_forbidden": true,
    "predeclared_seeds": [
      11,
      23,
      37,
      53,
      71
    ],
    "robust_ranking_requires_all_predeclared_seeds": true,
    "default_maxiter": 120,
    "default_tol": 1e-06
  },
  "common_parameter_bounds": {
    "H0": [
      60.0,
      80.0
    ],
    "Om": [
      0.1,
      0.6
    ],
    "Ob_h2": [
      0.018,
      0.026
    ]
  },
