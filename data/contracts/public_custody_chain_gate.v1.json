  "falsifiability_hypotheses": [
    {
      "id": "H-CUSTODY-MONEY-01",
      "state": "HYPOTHESIS",
      "statement": "A public-money trace is considered closed only when its jurisdiction-specific accounting stages can be linked by public identifiers and the reconciled ledger residual is within a predeclared tolerance.",
      "metric_or_observable": "stage_coverage + ledger_residual",
      "falsifiers": [
        "missing public trace identifier",
        "missing mandatory public source for an asserted stage",
        "ledger residual outside predeclared tolerance",
        "cash realization asserted before the jurisdiction-specific cash stage"
      ]
    },
    {
      "id": "H-CUSTODY-LOGISTICS-01",
      "state": "HYPOTHESIS",
      "statement": "Logistics instability is observable as changes in public lead time, receiving lapse and deadline slip without inferring motive from timing alone.",
      "metric_or_observable": "lead_time_hours + receiving_lapse_hours + deadline_slip_hours",
      "falsifiers": [
        "non-public shipment record",
        "non-monotonic sent-arrived-received timestamps",
        "deadline or completion timestamp not supported by a public source"
      ]
    },
    {
      "id": "H-CUSTODY-BULLWHIP-01",
      "state": "HYPOTHESIS",
      "statement": "A bullwhip proxy is present when the variance of a predeclared upstream public series exceeds the variance of its matched downstream public series over the same intervals.",
      "metric_or_observable": "variance(upstream) / variance(downstream)",
      "falsifiers": [
        "series use different periods or units",
        "fewer than four matched observations",
        "downstream variance is zero",
        "ratio is less than or equal to one"
      ]
    },
    {
      "id": "H-CUSTODY-GOVERNANCE-01",
      "state": "HYPOTHESIS",
      "statement": "Historical directive-body composition is reconstructable only as effective-dated public roles; present-tense role claims require an explicit as-of date.",
      "metric_or_observable": "role interval coverage + source coverage",
      "falsifiers": [
        "role lacks effective start date",
        "current role lacks as-of date",
        "role interval contradicts its cited public record"
      ]
    }
  ],
