  "routing_rules": [
    "NEW_OBSERVED requires at least one science route and one next_action.",
    "UNCERTAIN or UNKNOWN requires at least one typed gap with closure.",
    "CONTRADICTION requires at least two evidence/source refs or an explicit MISSING_COUNTERPART gap.",
    "ANOMALY cannot be promoted to mechanism without baseline, falsifier and independent evidence.",
    "OPPORTUNITY is a routing state, not evidence of truth.",
    "REFUSE must record reason and preserved source pointer.",
    "BUG or ERROR affecting program source routes to RafGitTools only after deterministic reproducer/root-cause evidence.",
    "Scientific claim promotion requires domain-specific gates in addition to this routing contract."
  ],
  "invariants": [
    "OBSERVER != OBSERVATION",
    "NEW != TRUE",
    "UNKNOWN != ZERO",
    "UNCERTAIN != FALSE",
    "ANOMALY != MECHANISM",
    "OPPORTUNITY != EVIDENCE",
    "VERBAL != MEASURED",
    "NONVERBAL != UNOBSERVABLE",
    "PARADOX != CONTRADICTION",
    "MULTIFILAMENT_RELATION != CAUSALITY",
    "SOURCE != ARTIFACT != EXECUTION != EVIDENCE != CLAIM",
    "TOKEN_VAZIO_GOVERNANCE != PASS"
  ]
