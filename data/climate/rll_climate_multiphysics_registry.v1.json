    "canonical_lift_required": true,
    "absence_policy": "VALIDITY_MASK_AND_TYPED_TOKEN_VAZIO"
  },
  "scheduler": {
    "sequence": [1, 2, 3, 5, 8, 13, 21, 34],
    "policy": "High priority selects a smaller multiplier; low priority selects a larger multiplier. Native source cadence and safety caps remain authoritative.",
