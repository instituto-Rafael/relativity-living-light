{
  "schema_version": "1.0",
  "registry_id": "rll-climate-multiphysics-8x8-v1",
  "claim_allowed": false,
  "matrix_contract": {
    "shape": [8, 8],
    "column_semantics": "Each column is one sector represented as one temporal/evidence gate plus seven normalized physical coordinates.",
    "row_0_role": "sector_transition_or_evidence_gate",
    "rows_1_7_role": "physical_coordinates_for_declared_canonical_lift_H7_to_B7",
