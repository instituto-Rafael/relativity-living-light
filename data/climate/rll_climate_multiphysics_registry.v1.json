        {"row": 3, "id": "sun_moon_elongation", "unit": "degree", "role": "EPHEMERIS", "warning_z": 3.0},
        {"row": 4, "id": "solid_earth_tide_vertical_displacement", "unit": "mm", "role": "MODELED_OR_OBSERVED", "warning_z": 3.0},
