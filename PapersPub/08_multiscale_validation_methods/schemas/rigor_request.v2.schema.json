{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rll.local/schemas/rigor_request.v2.schema.json",
  "title": "RLL RIGOR Procedure Request V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id","title","target_unit_ids","claim_goal","preset_id","requested_by","created_at"],
  "properties": {
    "request_id": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "target_unit_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(T(0[1-9]|1[0-6])|H(0[1-9]|[12][0-9]|3[0-2]))$"}},
    "claim_goal": {"enum":["TRUTH","NOVELTY","PUBLICATION","PHYSICAL_INTERPRETATION","METHOD_VALIDATION"]},
    "preset_id": {"enum":["MAX_RIGOR_MATHEMATICS","FORMAL_PROOF","DIAGNOSTIC_FAIL_CLOSED"]},
    "requested_by": {"type":"string","minLength":1},
    "created_at": {"type":"string","minLength":1},
    "notes": {"type":"string"}
  }
}
