    "default_enabled": false,
    "hosts": [
      "arxiv.org",
      "gitlab.com"
    ],
    "methods": [
      "GET"
    ],
    "purpose": "Optional source reachability probe only; calculation uses committed local scientific anchors."
  },
  "retention": {
    "raw_remote_payload_persisted": false,
    "repository_results_may_be_committed_only_by_explicit_opt_in": true
  },
  "claim_allowed": false
}
